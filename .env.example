# 이 파일을 .env로 복사한 뒤 값을 채운다. .env는 절대 커밋하지 않는다.
#   cp .env.example .env

# 카카오 로컬 API (장소 검색) - 백엔드 전용
KAKAO_REST_API_KEY=

# 카카오맵 JavaScript 키 - 프론트에서 사용하는 유일한 키
VITE_KAKAO_JS_KEY=

# ODsay 대중교통 경로 API - 백엔드 전용
ODSAY_API_KEY=

# (선택) Google Places API - 평점/리뷰 보강용, 백엔드 전용
GOOGLE_PLACES_API_KEY=

# true: 외부 API 대신 mock 구현 사용 / false: 실제 API 호출
USE_MOCK=true
