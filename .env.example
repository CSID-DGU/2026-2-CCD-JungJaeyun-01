# 이 파일을 .env로 복사한 뒤 값을 채운다. .env는 절대 커밋하지 않는다.
#   cp .env.example .env

# 카카오 로컬 API (장소 검색) - 백엔드 전용
KAKAO_REST_API_KEY=

# 카카오 로그인 (선택). 카카오디벨로퍼스 > 카카오 로그인 > 보안에서 Client Secret을 켠 경우에만 채운다. 백엔드 전용.
KAKAO_CLIENT_SECRET=
# 프론트 주소와 카카오 로그인 Redirect URI. 비워 두면 접속한 주소(localhost, cloudflared 터널 등)를 그대로 쓴다.
# 고정하고 싶을 때만 채운다. Redirect URI는 카카오 콘솔에 등록한 값(<접속주소>/auth/kakao/callback)과 같아야 한다.
FRONTEND_URL=
KAKAO_REDIRECT_URI=

# 카카오맵 JavaScript 키 - 프론트에서 사용하는 유일한 키
VITE_KAKAO_JS_KEY=

# Google Routes API (경로·이동시간) - 백엔드 전용. Cloud Console에서 Routes API 사용 설정이 필요하다.
GOOGLE_ROUTES_KEY=

# 경로 API 종류: google(기본) | odsay(기본 비활성화, providers/odsay.py)
ROUTE_PROVIDER=google

# 경로 API 호출 모드 (google일 때)
#   live:   (기본) 캐시 우선 → 없으면 실제 호출 후 저장. 하루 호출 상한은 backend/config/routes.yaml daily_call_limit
#   record: 실제로 호출하고 응답을 backend/fixtures/google/ 에 저장
#   replay: 저장된 응답만 사용, 호출 0 (테스트 전용)
ROUTE_MODE=live

# 2단계에서 경로 API로 확인할 후보 수 (1단계 추정 상위 N곳). 버스가 유리한 지역이 탈락하지 않도록 최종 3곳보다 넓게 잡는다.
# 비워 두면 backend/config/region.yaml의 shortlist_size(기본 8)를 쓴다.
SHORTLIST_SIZE=

# ODsay 대중교통 경로 API - ROUTE_PROVIDER=odsay일 때만 사용
ODSAY_API_KEY=

# (선택) Google Places API - 평점/리뷰 보강용, 백엔드 전용
GOOGLE_PLACES_API_KEY=

# mock 설정은 API별로 나뉘어 있고 pytest 전용이다 (실행 중 true면 서버가 시작되지 않는다). 기본은 모두 false(실제 API).
#   장소 검색(카카오, 무료)·평점(구글 Places, 하루 상한 place.yaml)·경로(구글 Routes, 캐시 우선 + 하루 상한 routes.yaml)
MOCK_PLACES=false
MOCK_RATINGS=false
MOCK_ROUTES=false

# 실시간 도착 정보 (선택, 백엔드 전용). 키가 없으면 실시간 표시만 "정보 없음"이 된다.
# 지하철: 서울 열린데이터광장(data.seoul.go.kr) "지하철 실시간 도착정보" 일반 인증키
SEOUL_SUBWAY_API_KEY=
# 버스: 공공데이터포털(data.go.kr) "서울특별시_정류소정보조회 서비스" + "버스도착정보조회 서비스" 활용신청 후 일반 인증키(Decoding)
SEOUL_BUS_API_KEY=
